{
  "name": "@sandbox/ui",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch src/index.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "react": "19.0.0-rc-1b3e3e2d-20240530",
    "react-dom": "19.0.0-rc-1b3e3e2d-20240530",
    "@radix-ui/react-slot": "1.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@sandbox/config": "workspace:*",
    "eslint": "9.4.0",
    "typescript": "5.4.5",
    "tsup": "8.0.2",
    "vitest": "1.6.0"
  }
}
